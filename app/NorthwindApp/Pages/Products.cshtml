@page
@model NorthwindApp.Pages.ProductsModel
@{
    ViewData["Title"] = "Products";
    ViewData["Error"] = Model.Error;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">Products</h1>
        <p class="text-muted mb-0">Manage your product inventory</p>
    </div>
    <a asp-page="/Products/Create" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i>New Product
    </a>
</div>

<!-- Filters -->
<div class="card mb-4">
    <div class="card-body">
        <form method="get" class="row g-3">
            <div class="col-md-4">
                <label class="form-label">Search</label>
                <input type="text" class="form-control" name="search" value="@Model.SearchTerm" placeholder="Search products...">
            </div>
            <div class="col-md-3">
                <label class="form-label">Category</label>
                <select class="form-select" name="categoryId">
                    <option value="">All Categories</option>
                    @foreach (var category in Model.Categories)
                    {
                        <option value="@category.CategoryID" selected="@(category.CategoryID == Model.SelectedCategoryId)">
                            @category.CategoryName
                        </option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">Min Price</label>
                <input type="number" class="form-control" name="minPrice" value="@Model.MinPrice" step="0.01" placeholder="£0.00">
            </div>
            <div class="col-md-2">
                <label class="form-label">Max Price</label>
                <input type="number" class="form-control" name="maxPrice" value="@Model.MaxPrice" step="0.01" placeholder="£100.00">
            </div>
            <div class="col-md-1 d-flex align-items-end">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-search"></i>
                </button>
            </div>
        </form>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.SearchTerm) || Model.SelectedCategoryId.HasValue || Model.MinPrice.HasValue || Model.MaxPrice.HasValue)
{
    <div class="alert alert-info d-flex justify-content-between align-items-center mb-4">
        <span>
            <i class="bi bi-funnel me-2"></i>
            Showing filtered results (@Model.Products.Count products)
        </span>
        <a asp-page="/Products" class="btn btn-sm btn-outline-primary">Clear Filters</a>
    </div>
}

<!-- Products Table -->
<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>Product Name</th>
                        <th>Supplier</th>
                        <th>Category</th>
                        <th>Qty/Unit</th>
                        <th class="text-end">Unit Price</th>
                        <th class="text-center">In Stock</th>
                        <th class="text-center">On Order</th>
                        <th class="text-center">Reorder Level</th>
                        <th class="text-center">Status</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var product in Model.Products)
                    {
                        <tr>
                            <td>
                                <a asp-page="/Products/Details" asp-route-id="@product.ProductID" class="text-decoration-none fw-medium">
                                    @product.ProductName
                                </a>
                            </td>
                            <td class="text-muted small">@product.SupplierName</td>
                            <td><span class="badge bg-light text-dark">@product.CategoryName</span></td>
                            <td class="small">@product.QuantityPerUnit</td>
                            <td class="text-end">£@product.UnitPrice?.ToString("N2")</td>
                            <td class="text-center">@product.UnitsInStock</td>
                            <td class="text-center">@product.UnitsOnOrder</td>
                            <td class="text-center">@product.ReorderLevel</td>
                            <td class="text-center">
                                @if (product.Discontinued)
                                {
                                    <span class="badge bg-danger">Discontinued</span>
                                }
                                else if (product.UnitsInStock <= product.ReorderLevel)
                                {
                                    <span class="badge bg-warning text-dark">Low Stock</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                            </td>
                            <td class="text-center">
                                <div class="btn-group btn-group-sm">
                                    <a asp-page="/Products/Edit" asp-route-id="@product.ProductID" class="btn btn-outline-primary" title="Edit">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a asp-page="/Products/Delete" asp-route-id="@product.ProductID" class="btn btn-outline-danger" title="Delete">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="mt-3 text-muted small">
    Showing @Model.Products.Count products
</div>
