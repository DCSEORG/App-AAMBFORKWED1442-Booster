@page
@model NorthwindApp.Pages.Products.CreateModel
@{
    ViewData["Title"] = "New Product";
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-page="/Index">Dashboard</a></li>
        <li class="breadcrumb-item"><a asp-page="/Products">Products</a></li>
        <li class="breadcrumb-item active">New Product</li>
    </ol>
</nav>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header">
                <i class="bi bi-plus-circle me-2"></i>Create New Product
            </div>
            <div class="card-body">
                <form method="post">
                    <div class="row g-3">
                        <div class="col-md-8">
                            <label asp-for="Product.ProductName" class="form-label">Product Name *</label>
                            <input asp-for="Product.ProductName" class="form-control" required />
                            <span asp-validation-for="Product.ProductName" class="text-danger"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Product.UnitPrice" class="form-label">Unit Price</label>
                            <div class="input-group">
                                <span class="input-group-text">£</span>
                                <input asp-for="Product.UnitPrice" class="form-control" type="number" step="0.01" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Product.CategoryID" class="form-label">Category</label>
                            <select asp-for="Product.CategoryID" asp-items="Model.Categories" class="form-select">
                                <option value="">-- Select Category --</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Product.SupplierID" class="form-label">Supplier</label>
                            <select asp-for="Product.SupplierID" asp-items="Model.Suppliers" class="form-select">
                                <option value="">-- Select Supplier --</option>
                            </select>
                        </div>
                        <div class="col-md-12">
                            <label asp-for="Product.QuantityPerUnit" class="form-label">Quantity Per Unit</label>
                            <input asp-for="Product.QuantityPerUnit" class="form-control" placeholder="e.g., 24 - 12 oz bottles" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Product.UnitsInStock" class="form-label">Units In Stock</label>
                            <input asp-for="Product.UnitsInStock" class="form-control" type="number" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Product.UnitsOnOrder" class="form-label">Units On Order</label>
                            <input asp-for="Product.UnitsOnOrder" class="form-control" type="number" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Product.ReorderLevel" class="form-label">Reorder Level</label>
                            <input asp-for="Product.ReorderLevel" class="form-control" type="number" />
                        </div>
                        <div class="col-12">
                            <div class="form-check">
                                <input asp-for="Product.Discontinued" class="form-check-input" type="checkbox" />
                                <label asp-for="Product.Discontinued" class="form-check-label">Discontinued</label>
                            </div>
                        </div>
                    </div>
                    <hr class="my-4" />
                    <div class="d-flex justify-content-between">
                        <a asp-page="/Products" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-1"></i>Cancel
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-lg me-1"></i>Create Product
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
