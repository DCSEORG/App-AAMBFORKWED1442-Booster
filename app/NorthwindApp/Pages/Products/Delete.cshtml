@page "{id:int}"
@model NorthwindApp.Pages.Products.DeleteModel
@{
    ViewData["Title"] = $"Delete - {Model.Product?.ProductName}";
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-page="/Index">Dashboard</a></li>
        <li class="breadcrumb-item"><a asp-page="/Products">Products</a></li>
        <li class="breadcrumb-item active">Delete</li>
    </ol>
</nav>

@if (Model.Product != null)
{
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card border-danger">
                <div class="card-header bg-danger text-white">
                    <i class="bi bi-exclamation-triangle me-2"></i>Confirm Delete
                </div>
                <div class="card-body">
                    <p class="mb-3">Are you sure you want to delete this product?</p>
                    
                    <div class="bg-light p-3 rounded mb-3">
                        <h5 class="mb-2">@Model.Product.ProductName</h5>
                        <p class="mb-1 text-muted small">Category: @Model.Product.CategoryName</p>
                        <p class="mb-1 text-muted small">Supplier: @Model.Product.SupplierName</p>
                        <p class="mb-0 text-muted small">Price: £@Model.Product.UnitPrice?.ToString("N2")</p>
                    </div>

                    <div class="alert alert-warning mb-3">
                        <i class="bi bi-info-circle me-1"></i>
                        This action cannot be undone.
                    </div>

                    <form method="post" class="d-flex justify-content-between">
                        <a asp-page="/Products" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-1"></i>Cancel
                        </a>
                        <button type="submit" class="btn btn-danger">
                            <i class="bi bi-trash me-1"></i>Delete Product
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="alert alert-warning">
        <i class="bi bi-exclamation-triangle me-2"></i>Product not found
    </div>
    <a asp-page="/Products" class="btn btn-primary">Back to Products</a>
}
