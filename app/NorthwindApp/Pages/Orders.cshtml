@page
@model NorthwindApp.Pages.OrdersModel
@{
    ViewData["Title"] = "Orders";
    ViewData["Error"] = Model.Error;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">Orders</h1>
        <p class="text-muted mb-0">
            @if (!string.IsNullOrEmpty(Model.CustomerId))
            {
                <span>Orders for customer @Model.CustomerId</span>
            }
            else
            {
                <span>View all customer orders</span>
            }
        </p>
    </div>
    @if (!string.IsNullOrEmpty(Model.CustomerId))
    {
        <a asp-page="/Orders" class="btn btn-outline-primary">View All Orders</a>
    }
</div>

<!-- Orders Table -->
<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>Order ID</th>
                        <th>Customer</th>
                        <th>Employee</th>
                        <th>Order Date</th>
                        <th>Required Date</th>
                        <th>Shipped Date</th>
                        <th>Ship To</th>
                        <th>Shipper</th>
                        <th class="text-end">Freight</th>
                        <th class="text-center">Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model.Orders)
                    {
                        <tr>
                            <td><code>@order.OrderID</code></td>
                            <td class="fw-medium">@order.CustomerName</td>
                            <td class="text-muted small">@order.EmployeeName</td>
                            <td>@order.OrderDate?.ToString("dd MMM yyyy")</td>
                            <td>@order.RequiredDate?.ToString("dd MMM yyyy")</td>
                            <td>@order.ShippedDate?.ToString("dd MMM yyyy")</td>
                            <td class="small">@order.ShipCity, @order.ShipCountry</td>
                            <td class="small">@order.ShipperName</td>
                            <td class="text-end">£@order.Freight?.ToString("N2")</td>
                            <td class="text-center">
                                @if (order.ShippedDate.HasValue)
                                {
                                    <span class="badge bg-success">Shipped</span>
                                }
                                else if (order.RequiredDate < DateTime.Now)
                                {
                                    <span class="badge bg-danger">Overdue</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">Pending</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="mt-3 text-muted small">
    Showing @Model.Orders.Count orders
</div>
